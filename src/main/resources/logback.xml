<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ============================= -->
    <!-- Allgemeine Properties -->
    <!-- ============================= -->

    <!-- App-Name (optional) -->
    <property name="APP_NAME" value="bcp-andwendung"/>

    <!-- Log-Verzeichnis -->
    <property name="LOG_PATH" value="logs"/>

    <!-- ============================= -->
    <!-- Pattern (Spring-Boot-ähnlich) -->
    <!-- ============================= -->

    <property name="LOGBACK_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level --- [%thread] %logger{36} : %msg%n"/>

    <!-- ============================= -->
    <!-- Appender -->
    <!-- ============================= -->

    <!-- Konsole -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOGBACK_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Datei mit Rotation -->
    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOGBACK_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ============================= -->
    <!-- Root Logger -->
    <!-- ============================= -->

    <!-- Standard: INFO -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- ============================= -->
    <!-- Klassen- / Paketsteuerung -->
    <!-- ============================= -->

    <!-- Komplett AUS für eine Klasse -->
    <logger name="ChatAnwendung.Impl.persistence.ThreadPools" level="OFF"/>

    <!-- DEBUG nur für eine konkrete Klasse -->
    <logger name="ChatAnwendung.Main" level="DEBUG"/>

    <!-- InputHandler -->

    <logger name="ChatAnwendung.Impl.Handler.InputHandlers" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.InputHandlers.ConnectHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.InputHandlers.DisconnectHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.InputHandlers.ExitInputHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.InputHandlers.FileInputHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.InputHandlers.GoodbyeInputHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.InputHandlers.HelloInputHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.InputHandlers.InputHandlerImpl" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.InputHandlers.ListHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.InputHandlers.MessageInputHandler" level="DEBUG"/>

    <!-- Receive Handler -->

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.FeedForwadingHanlder" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.FileDataRecieveHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.FileEndRecieveHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.FileInitRecieveHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.GoodbyeRecieveHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.HeartbeatRecieveHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.HelloRecieveHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.MessageRecieveHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.RecieverHandlerImpl" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.RequestRecieveHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.RoutingTableRecievetHandler" level="DEBUG"/>

    <logger name="ChatAnwendung.Impl.Handler.ReceiverHandlers.WelcomeRecieveHandler" level="DEBUG"/>




    <!-- Fremdbibliotheken einschränken -->
    <logger name="org.slf4j" level="WARN"/>
    <logger name="org.apache" level="WARN"/>

</configuration>
